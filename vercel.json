{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "services": {
    "app": { "root": ".", "framework": "nextjs" },
    "mision": { "root": "mision", "framework": "eve" }
  },
  "rewrites": [
    { "source": "/eve/(.*)", "destination": { "service": "mision" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
