# Explorar el original (token personal de /evento). Uno por explorador en paralelo:
CAJA_TOKEN=
# CAJA_TOKEN_2=
# CAJA_TOKEN_3=

# Token del equipo que acepta el reemplazo (tarjeta del reto en /evento)
TEAM_TOKEN=

# Opcional: por defecto la URL del material
# ORIGINAL_URL=https://caja-negra-production-c64f.up.railway.app

# Estado compartido en Vercel (Upstash Redis del Marketplace). Los inyecta Vercel; en local: pnpm env:pull.
# Sin ellas el reemplazo usa memoria de un solo proceso.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
