# Token PROPIO del agente para el original (de /evento). Distinto del de cualquier persona: cada token tiene su estado.
# Nunca entra al sandbox: el firewall lo inyecta solo mientras corre probe.py.
CAJA_TOKEN_AGENTE=
# Si no hay token propio, el agente usa CAJA_TOKEN (el personal). Entonces nadie debe sondear a mano mientras corre.
# CAJA_TOKEN=

# GitHub fine-grained token, SOLO el repo LucasLeguizamo/lab10-caja-negra:
# Contents (read/write) + Pull requests (read/write). Para reclamar ramas mision/* y abrir PRs en borrador.
GITHUB_TOKEN=

# Modelo: DeepSeek Flash vía OpenRouter (agent/lib/modelo.ts). Key de openrouter.ai/keys, con tope de gasto.
OPENROUTER_API_KEY=
# Opcional: otro modelo de OpenRouter sin tocar código (p.ej. deepseek/deepseek-v4-flash).
# MISION_MODELO=

# Sandbox y Blob (bitácora) llegan por OIDC tras `eve link` y `eve add memory/file`: no van aquí.
